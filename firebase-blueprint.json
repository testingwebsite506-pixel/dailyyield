{
  "entities": {
    "User": {
      "title": "User Profile",
      "description": "User wallet, earnings, and engagement data",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "photoURL": { "type": "string" },
        "balanceNGN": { "type": "number", "description": "Current balance in NGN" },
        "walletBalance": { "type": "number", "description": "Legacy/Sync balance field" },
        "totalProfitNGN": { "type": "number", "description": "Total lifetime earnings in NGN" },
        "hasDepositedBefore": { "type": "boolean" },
        "firstDepositBonusClaimed": { "type": "boolean", "description": "Flag for tracking if the first deposit bonus has been credited" },
        "isWalletFrozen": { "type": "boolean", "description": "If true, user cannot make outbound transactions" },
        "referralActive": { "type": "boolean" },
        "activeInvestments": { "type": "array", "items": { "type": "string" }, "description": "List of active investment IDs" },
        "streak": { "type": "integer", "description": "Current daily check-in streak" },
        "totalGamesPlayed": { "type": "integer" },
        "lastCheckIn": { "type": "any" },
        "createdAt": { "type": "any" },
        "kycStatus": { "type": "string", "enum": ["pending", "verified", "rejected"], "default": "pending" },
        "tier": { "type": "string", "enum": ["tier1", "tier2", "tier3", "premium"], "default": "tier1" },
        "kycDocs": { "type": "object", "description": "Links to KYC document images" }
      },
      "required": ["uid", "email", "displayName", "balanceNGN", "totalProfitNGN", "activeInvestments", "streak", "totalGamesPlayed", "createdAt", "kycStatus", "tier"]
    },
    "TierRequest": {
      "title": "Tier Upgrade Request",
      "description": "User request to upgrade their account tier",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "currentTier": { "type": "string" },
        "requestedTier": { "type": "string" },
        "message": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "approved", "rejected"] },
        "createdAt": { "type": "any" }
      },
      "required": ["uid", "requestedTier", "status", "createdAt"]
    },
    "KycRequest": {
      "title": "KYC Verification Request",
      "description": "User submission for identity verification",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "phoneNumber": { "type": "string" },
        "address": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "verified", "rejected"] },
        "submittedAt": { "type": "any" }
      },
      "required": ["uid", "status", "submittedAt"]
    },
    "Investment": {
      "title": "User Investment",
      "description": "An active or completed investment plan",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "planId": { "type": "string", "description": "Plan duration ID (3d, 7d, 30d)" },
        "capital": { "type": "number", "description": "Amount invested" },
        "rate": { "type": "number", "description": "Total interest rate for the period (e.g. 0.05 for 5%)" },
        "durationDays": { "type": "integer" },
        "startTime": { "type": "any" },
        "endTime": { "type": "any" },
        "status": { "type": "string", "enum": ["active", "completed"] },
        "currentProfit": { "type": "number", "description": "Accumulated profit so far" }
      },
      "required": ["userId", "planId", "capital", "rate", "durationDays", "startTime", "endTime", "status"]
    },
    "Transaction": {
      "title": "Transaction Log",
      "description": "Financial records of deposits, investments, and payouts",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "type": { "type": "string", "enum": ["deposit", "withdrawal", "investment", "payout", "game_fee", "game_win"] },
        "amount": { "type": "number" },
        "status": { "type": "string", "enum": ["pending", "completed", "failed"] },
        "createdAt": { "type": "any" }
      },
      "required": ["userId", "type", "amount", "status", "createdAt"]
    },
    "Notification": {
      "title": "Notification",
      "description": "System alerts, payouts, and wins",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "message": { "type": "string" },
        "type": { "type": "string", "enum": ["system", "payout", "win", "alert"] },
        "createdAt": { "type": "any" }
      },
      "required": ["userId", "title", "message", "type", "createdAt"]
    },
    "MarketDuelBid": {
      "title": "Market Duel Bid",
      "description": "User bid on a market duel round",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "roundId": { "type": "number" },
        "selection": { "type": "string", "enum": ["A", "B"] },
        "amount": { "type": "number" },
        "status": { "type": "string", "enum": ["active", "won", "lost"] },
        "payout": { "type": "number" },
        "createdAt": { "type": "any" }
      },
      "required": ["userId", "roundId", "selection", "amount", "status", "createdAt"]
    },
    "Withdrawal": {
      "title": "Withdrawal",
      "description": "User request to withdraw funds",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "userEmail": { "type": "string" },
        "tier": { "type": "string" },
        "amount": { "type": "number" },
        "status": { "type": "string", "enum": ["pending", "approved", "rejected", "approved_done"] },
        "details": { "type": "object" },
        "createdAt": { "type": "any" }
      },
      "required": ["userId", "userEmail", "tier", "amount", "status", "details", "createdAt"]
    },
    "Airdrop": {
      "title": "Airdrop",
      "description": "A global promotional fund drop",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "description": { "type": "string" },
        "amount": { "type": "number" },
        "status": { "type": "string", "enum": ["active", "hidden"] },
        "totalClaims": { "type": "number" },
        "createdAt": { "type": "any" }
      },
      "required": ["name", "description", "amount", "status", "totalClaims", "createdAt"]
    },
    "AirdropClaim": {
      "title": "Airdrop Claim",
      "description": "Record of a user claiming a specific airdrop",
      "type": "object",
      "properties": {
        "claimed": { "type": "boolean" },
        "claimedAt": { "type": "any" },
        "amount": { "type": "number" },
        "airdropName": { "type": "string" }
      },
      "required": ["claimed", "claimedAt", "amount", "airdropName"]
    },
    "DepositRequest": {
      "title": "Deposit Request",
      "description": "A manual pending deposit for approval",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "username": { "type": "string" },
        "email": { "type": "string" },
        "amount": { "type": "number" },
        "reference": { "type": "string" },
        "transactionId": { "type": "string", "description": "Optional bank transaction ID for faster verification" },
        "status": { "type": "string", "enum": ["pending", "approved", "cancelled"] },
        "isFirstDeposit": { "type": "boolean" },
        "createdAt": { "type": "any" }
      },
      "required": ["userId", "amount", "reference", "status", "createdAt"]
    },
    "ReferralRequest": {
      "title": "Referral Redemption Request",
      "description": "A manual request to redeem a referral code",
      "type": "object",
      "properties": {
        "referrerCode": { "type": "string" },
        "referrerUid": { "type": "string" },
        "referredUserId": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "approved", "rejected"] },
        "createdAt": { "type": "any" }
      },
      "required": ["referrerCode", "referrerUid", "referredUserId", "status", "createdAt"]
    },
    "PageStatus": {
      "title": "Page Visibility Status",
      "description": "Toggles for enabling/disabling app sections",
      "type": "object",
      "properties": {
        "dashboard": { "type": "boolean" },
        "portfolio": { "type": "boolean" },
        "gamehub": { "type": "boolean" },
        "marketduel": { "type": "boolean" },
        "wallet": { "type": "boolean" },
        "notifications": { "type": "boolean" },
        "account": { "type": "boolean" },
        "invest": { "type": "boolean" },
        "referral": { "type": "boolean" },
        "faq": { "type": "boolean" },
        "airdrop": { "type": "boolean" },
        "tiers": { "type": "boolean" },
        "deposit-request": { "type": "boolean" },
        "market_duel_multiplier": { "type": "number", "description": "Global multiplier for Market Duel wins (e.g., 1.5 for 1.5x)" },
        "game_hub_min_reward": { "type": "number", "description": "Minimum reward for Game Hub (NGN)" },
        "game_hub_max_reward": { "type": "number", "description": "Maximum reward for Game Hub (NGN)" },
        "game_locks": { 
          "type": "object", 
          "description": "Lock status for each game in Game Hub",
          "additionalProperties": { "type": "boolean" }
        }
      }
    }
  },
  "firestore": {
    "/system/page_status": {
      "schema": "PageStatus",
      "description": "Global toggles for page availability"
    },
    "/marketDuelOutcomes/{roundId}": {
      "schema": "object",
      "description": "Admin defined winners for Market Duel rounds"
    },
    "/users/{userId}": {
      "schema": "User",
      "description": "Individual user accounts"
    },
    "/depositRequests/{depositId}": {
      "schema": "DepositRequest",
      "description": "Manual deposit approval requests"
    },
    "/referralRequests/{requestId}": {
      "schema": "ReferralRequest",
      "description": "Manual referral redemption requests"
    },
    "/users/{userId}/airdropsClaimed/{airdropId}": {
      "schema": "AirdropClaim",
      "description": "Record of claimed airdrops per user"
    },
    "/airdrops/{airdropId}": {
      "schema": "Airdrop",
      "description": "Global airdrop listing"
    },
    "/investments/{investmentId}": {
      "schema": "Investment",
      "description": "User investments"
    },
    "/transactions/{transactionId}": {
      "schema": "Transaction",
      "description": "User transaction logs"
    },
    "/notifications/{notificationId}": {
      "schema": "Notification",
      "description": "User notifications"
    },
    "/tierRequests/{requestId}": {
      "schema": "TierRequest",
      "description": "Tier upgrade requests"
    },
    "/kycRequests/{requestId}": {
      "schema": "KycRequest",
      "description": "KYC verification requests"
    },
    "/marketDuelBids/{bidId}": {
      "schema": "MarketDuelBid",
      "description": "User market duel bids"
    },
    "/withdrawals/{withdrawalId}": {
      "schema": "Withdrawal",
      "description": "User liquidity exit requests"
    }
  }
}
